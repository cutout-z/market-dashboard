[Unit]
Description=ARCHIVED VPS ONLY - Market Dashboard + Autoresearch Worker
Documentation=https://github.com/cutout-z/market-dashboard
After=docker.service network-online.target
Requires=docker.service

# Active runtime moved to the QNAP NAS runner on 2026-05-29. See:
# /share/AI_Wif_Brain_Work/runner-stack/scripts/qnap-run-job market-dashboard
# /share/AI_Wif_Brain_Work/runner-stack/scripts/qnap-run-job market-worker
# tools/nas-runner/compose.yml in the local workspace.

[Service]
Type=simple
User=root
WorkingDirectory=/home/market/app/market-dashboard

# Loads API keys into the service environment
EnvironmentFile=/etc/market-dashboard/env

ExecStart=/home/market/app/market-dashboard/deploy/start.sh
ExecStop=/bin/bash -c 'cd /home/market/app/market-dashboard && docker compose down'

Restart=on-failure
RestartSec=30s

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
